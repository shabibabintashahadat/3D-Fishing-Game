    global player_position, player_rot, fishing_line_is_active, hook_is_cast, hookPos, auto_cast_time
    global isPaused, score, currentLevel, startTime, cheatModeOn, hookCastAngle, hookCastDistance
    global is_underwater, camera_pos, underwater_cam_pos, surface_cam_pos, gameOver, missedCatches, cast_with_cheat

    if key == b'r':
        score = 0
        currentLevel = 1
        startTime = time.time()
        spawnFish()
        player_position = [0, WATER_LVL, 0]
        player_rot = 0
        fishing_line_is_active = False
        hook_is_cast = False
        hookPos = [0, WATER_LVL, 0]
        cheatModeOn = False
        missedCatches = 0
        gameOver = False
        cast_with_cheat = False
        return
    if gameOver:
        return

    moveSpeed = 5

    if key == b'u':
        is_underwater = not is_underwater
        if is_underwater:
            surface_cam_pos = camera_pos[:]
            camera_pos = underwater_cam_pos[:]
        else:
            underwater_cam_pos = camera_pos[:]
            camera_pos = surface_cam_pos[:]
    elif key == b'w':
        player_position[0] = player_position[0] + math.sin(math.radians(player_rot)) * moveSpeed
        player_position[2] = player_position[2] - math.cos(math.radians(player_rot)) * moveSpeed
    elif key == b's':
        player_position[0] = player_position[0] - math.sin(math.radians(player_rot)) * moveSpeed
        player_position[2] = player_position[2] + math.cos(math.radians(player_rot)) * moveSpeed
    elif key == b'a':
        player_rot = player_rot + 5
    elif key == b'd':
        player_rot = player_rot - 5
    elif key == b' ':
        if not fishing_line_is_active and not cheatModeOn:
            fishing_line_is_active = True
            hook_is_cast = True
            hookPos = [player_position[0], WATER_LVL, player_position[2]]
            hookCastAngle = player_rot
            hookCastDistance = 50
            cast_with_cheat = False
    elif key == b'f':
        if fishing_line_is_active:
            hook_is_cast = False
    elif key == b'c':
        cheatModeOn = not cheatModeOn
        if cheatModeOn:
            print("CHEAT MODE: ON")
        else:
            print("CHEAT MODE: OFF")
        cast_with_cheat = False
    elif key == b'p':
        isPaused = not isPaused

    if player_position[0] > GRID_LENGTH / 3:
        player_position[0] = GRID_LENGTH / 3
    if player_position[0] < -GRID_LENGTH / 3:
        player_position[0] = -GRID_LENGTH / 3
    if player_position[2] > GRID_LENGTH / 3:
        player_position[2] = GRID_LENGTH / 3
    if player_position[2] < -GRID_LENGTH / 3:
        player_position[2] = -GRID_LENGTH / 3


def specialKeyHandler(key, x, y):
    global camera_pos, underwater_cam_pos, surface_cam_pos, is_underwater

    cameraSpeed = 10

    if key == GLUT_KEY_UP:
        if is_underwater:
            camera_pos[1] = camera_pos[1] + cameraSpeed
            if camera_pos[1] > WATER_LVL - 10:
                camera_pos[1] = WATER_LVL - 10
        else:
            camera_pos[1] = camera_pos[1] + cameraSpeed
            if camera_pos[1] > 200:
                camera_pos[1] = 200
    elif key == GLUT_KEY_DOWN:
        if is_underwater:
            camera_pos[1] = camera_pos[1] - cameraSpeed
            if camera_pos[1] < -80:
                camera_pos[1] = -80
        else:
            camera_pos[1] = camera_pos[1] - cameraSpeed
            if camera_pos[1] < 50:
                camera_pos[1] = 50
    elif key == GLUT_KEY_LEFT:
        angle = math.atan2(camera_pos[0], camera_pos[2])
        angle = angle - 0.1
        distance = math.sqrt(camera_pos[0] * camera_pos[0] + camera_pos[2] * camera_pos[2])
        camera_pos[0] = distance * math.sin(angle)
        camera_pos[2] = distance * math.cos(angle)
    elif key == GLUT_KEY_RIGHT:
        angle = math.atan2(camera_pos[0], camera_pos[2])
        angle = angle + 0.1
        distance = math.sqrt(camera_pos[0] * camera_pos[0] + camera_pos[2] * camera_pos[2])
        camera_pos[0] = distance * math.sin(angle)
        camera_pos[2] = distance * math.cos(angle)

    if is_underwater:
        underwater_cam_pos = camera_pos[:]
    else:
        surface_cam_pos = camera_pos[:]


def mouseHandler(button, state, x, y):
    global fishing_line_is_active, hook_is_cast, hookPos, hookCastAngle, hookCastDistance, auto_cast_time, cast_with_cheat

    if cheatModeOn:
        return

    if button == GLUT_LEFT_BUTTON and state == GLUT_DOWN:
        if not fishing_line_is_active:
            centerX = 500
            centerY = 400
            deltaX = x - centerX
            deltaY = centerY - y

            hookCastAngle = player_rot + (deltaX / 10)
            hookCastDistance = abs(deltaY) / 2
            if hookCastDistance > 100:
                hookCastDistance = 100

            fishing_line_is_active = True
            hook_is_cast = True
            hookPos = [player_position[0], WATER_LVL, player_position[2]]
            cast_with_cheat = cheatModeOn

    elif button == GLUT_RIGHT_BUTTON and state == GLUT_DOWN:
        if fishing_line_is_active:
            hook_is_cast = False


def setupCameraView():
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluPerspective(fovY, 1.25, 0.1, 1500)
    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()

    x = camera_pos[0]
    y = camera_pos[1]
    z = camera_pos[2]

    if is_underwater:
        gluLookAt(x, y, z,
                  0, y, 0,
                  0, 1, 0)
    else:
        gluLookAt(x, y, z,
                  player_position[0], player_position[1], player_position[2],
                  0, 1, 0)


def idleFunction():
    global waveTime, gameTime

    if not isPaused and not gameOver:
        waveTime = waveTime + animSpeed
        gameTime = time.time() - startTime

        for fish in fishList:
            fish.update()

        autoPlayFunction()
        updateHook()

    glutPostRedisplay()


def displayFunction():
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()
    glViewport(0, 0, 1000, 800)

    setupCameraView()

    drawEnvironment()
    drawWaterSurface()
    drawBubbles()

    drawAllShapes()

    if is_underwater:
        viewText = "UNDERWATER VIEW"
    else:
        viewText = "SURFACE VIEW"

    ScoreForNextlevel = (currentLevel * fish_per_level) - score
    drawText(10, 770, viewText + " | Score: " + str(score) + " | Level: " + str(currentLevel) + " | Score for Next Level: " + str(ScoreForNextlevel) + " | Misses: " + str(missedCatches) + "/" + str(maxMisses))

    if gameOver:
        drawText(350, 400, "GAME OVER!", GLUT_BITMAP_HELVETICA_18)
        drawText(320, 350, "Too many misses! (" + str(missedCatches) + "/" + str(maxMisses) + ")")
        drawText(340, 300, "Press R to Restart", GLUT_BITMAP_HELVETICA_18)

    if cheatModeOn:
        glColor3f(1, 0, 0)
        drawText(10, 710, "CHEAT MODE: ON")

    if is_underwater:
        drawText(10, 100, "W/A/S/D: Forward/Back/Turn Boat | U: Surface View")
        drawText(10, 60, "Left Click: Cast | Right Click: Reel  | C: Cheat | R: Restart | P: Pause")
    else:
        drawText(10, 30, "W/A/S/D: Forward/Back/Turn Boat | U: Surface View")
        drawText(10, 60, "Left Click: Cast | C: Cheat | R: Reset | P: Pause")
        drawText(10, 90, "Press U to go underwater and see fish better!")

    if isPaused:
        drawText(450, 400, "PAUSED", GLUT_BITMAP_HELVETICA_18)

    if not is_underwater and score == 0:
        drawText(300, 300, "Welcome to 3D Fishing Game!", GLUT_BITMAP_HELVETICA_18)
        drawText(350, 270, "Press U to dive underwater!", GLUT_BITMAP_HELVETICA_18)

    glutSwapBuffers()


def main():
    glutInit()
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH)
    glutInitWindowSize(1000, 800)
    glutInitWindowPosition(0, 0)
    window = glutCreateWindow(b"3D Fishing Game")
    spawnFish()

    glutDisplayFunc(displayFunction)
    glutKeyboardFunc(keyboardHandler)
    glutSpecialFunc(specialKeyHandler)
    glutMouseFunc(mouseHandler)
    glutIdleFunc(idleFunction)

    glutMainLoop()

if __name__ == "__main__":
    main()
