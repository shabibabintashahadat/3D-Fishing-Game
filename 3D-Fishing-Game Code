def spawnFish():
    global fishList
    fishList = []
    for i in range(MAX_FISH):
        newFish = Fish()
        fishList.append(newFish)


def updateHook():
    global hookPos, hook_is_cast, fishing_line_is_active, missedCatches, gameOver, cast_with_cheat, current_cast_caught
    global hook_wait_time, hook_waiting

    if hook_is_cast:
        if hookPos[1] > hook_target_depth:
            hookPos[1] = hookPos[1] - 2
            progress = (WATER_LVL - hookPos[1]) / (WATER_LVL - hook_target_depth)
            hookPos[0] = player_position[0] + math.sin(math.radians(hookCastAngle)) * hookCastDistance * progress
            hookPos[2] = player_position[2] - math.cos(math.radians(hookCastAngle)) * hookCastDistance * progress
            checkFishCollision()
        else:
            hook_is_cast = False
            hook_waiting = True
            hook_wait_time = 0
    elif hook_waiting:
        hook_wait_time += 1
        checkFishCollision()
        if hook_wait_time >= HOOK_WAIT_DURATION:
            hook_waiting = False
    elif fishing_line_is_active and hookPos[1] < WATER_LVL:
        hookPos[1] += 3
        checkFishCollision()
        if hookPos[1] >= WATER_LVL:
            fishing_line_is_active = False
            for fish in fishList:
                if fish.isBeingReeled:
                    fish.isCaught = True
                    fish.isBeingReeled = False
            if not current_cast_caught:
                if not cast_with_cheat:
                    missedCatches += 1
                    if missedCatches >= maxMisses:
                        gameOver = True
            current_cast_caught = False
            cast_with_cheat = False


def checkFishCollision():
    global score, currentLevel, caught, current_cast_caught

    if not fishing_line_is_active:
        return False
    caught = False
    for fish in fishList:
        if fish.isCaught or fish.isBeingReeled:
            continue

        dx = fish.x - hookPos[0]
        dy = fish.y - hookPos[1]
        dz = fish.z - hookPos[2]
        distance = math.sqrt(dx * dx + dy * dy + dz * dz)

        if distance < fish.fishSize + 8:
            fish.isBeingReeled = True
            score = score + fish.points
            caught = True
            current_cast_caught = True
            if score >= currentLevel * fish_per_level:
                currentLevel = currentLevel + 1
                spawnFish()
            return True
    return caught


def autoPlayFunction():
    global fishing_line_is_active, hook_is_cast, hookPos, hookCastAngle, hookCastDistance,cast_with_cheat,auto_cast_time

    if not cheatModeOn:
        return

    if not fishing_line_is_active:
        auto_cast_time = auto_cast_time + 1
        if auto_cast_time > 30:
            nearestFish = None
            nearestDistance = 999999

            for fish in fishList:
                if not fish.isCaught:
                    fishDist = math.sqrt(
                        (fish.x - player_position[0]) * (fish.x - player_position[0]) +
                        (fish.z - player_position[2]) * (fish.z - player_position[2])
                    )
                    if fishDist < nearestDistance and fishDist < 150:
                        nearestDistance = fishDist
                        nearestFish = fish

            if nearestFish != None:
                dx = nearestFish.x - player_position[0]
                dz = nearestFish.z - player_position[2]
                hookCastAngle = math.degrees(math.atan2(dx, -dz))
                hookCastDistance = math.sqrt(dx * dx + dz * dz)

                fishing_line_is_active = True
                hook_is_cast = True
                hookPos = [player_position[0], WATER_LVL, player_position[2]]
                auto_cast_time = 0
                cast_with_cheat = True
    else:
        if not hook_is_cast and hookPos[1] <= hook_target_depth + 10:
            fishNearby = False
            for fish in fishList:
                if not fish.isCaught:
                    fishDistance = math.sqrt(
                        (fish.x - hookPos[0]) * (fish.x - hookPos[0]) +
                        (fish.y - hookPos[1]) * (fish.y - hookPos[1]) +
                        (fish.z - hookPos[2]) * (fish.z - hookPos[2])
                    )
                    if fishDistance < 30:
                        fishNearby = True
                        break

            if not fishNearby:
                hook_is_cast = False


