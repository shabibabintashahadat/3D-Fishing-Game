class Fish:
    def __init__(self):
        self.x = random.uniform(-GRID_LENGTH / 3, GRID_LENGTH / 3)
        self.y = random.uniform(-60, 0)
        self.z = random.uniform(-GRID_LENGTH / 3, GRID_LENGTH / 3)
        self.fishSize = random.uniform(8, 16)
        self.speed = random.uniform(0.3, 0.8)
        self.direction = random.uniform(0, 360)
        self.fishColor = self.get_random_color()
        self.fishType = random.choice(['normal', 'gold', 'big'])
        if self.fishType == 'normal':
            self.points = 1
        elif self.fishType == 'gold':
            self.points = 3
        else:
            self.points = 2
        self.isCaught = False
        self.baseY = self.y
        self.swimAnim = random.uniform(0, 360)
        self.isBeingReeled = False
        self.originalX = self.x
        self.originalY = self.y
        self.originalZ = self.z

    
    def get_random_color(self):
        colors = [
            (1.0, 0.3, 0.2),
            (0.8, 0.2, 0.2),
            (0.2, 0.8, 0.3),
            (1.0, 1.0, 0.2),
            (0.5, 0.2, 0.8)
        ]
        return colors[random.randint(0, len(colors) - 1)]

    
    def update(self):
        if self.isCaught:
            return

        if self.isBeingReeled:
            self.x = hookPos[0]
            self.y = hookPos[1] - 10
            self.z = hookPos[2]
            return

        self.direction += random.uniform(-5, 5)
        dx = math.cos(math.radians(self.direction)) * self.speed
        dz = math.sin(math.radians(self.direction)) * self.speed

        self.x = self.x + dx
        self.z += dz

        if self.x > GRID_LENGTH / 3 or self.x < -GRID_LENGTH / 3:
            self.direction = 180 - self.direction
            if self.x > GRID_LENGTH / 3:
                self.x = GRID_LENGTH / 3
            else:
                self.x = -GRID_LENGTH / 3

        if self.z > GRID_LENGTH / 3 or self.z < -GRID_LENGTH / 3:
            self.direction = -self.direction
            if self.z > GRID_LENGTH / 3:
                self.z = GRID_LENGTH / 3
            else:
                self.z = -GRID_LENGTH / 3

        self.swimAnim = self.swimAnim + 2
        self.y = self.baseY + math.sin(math.radians(self.swimAnim)) * 5

        if self.y > WATER_LVL - 10:
            self.y = WATER_LVL - 10
            self.baseY = self.y - 5
        if self.y < -80:
            self.y = -80
            self.baseY = self.y


